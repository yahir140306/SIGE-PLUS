---
// Componente reutilizable y desacoplado de Login para SIGE+
interface Props {
  defaultRedirect?: string;
}

const { defaultRedirect = "/" } = Astro.props;
---

<div class="max-w-md w-full mx-auto">
  <!-- Tarjeta Principal de Login -->
  <div
    class="bg-white dark:bg-slate-800 rounded-3xl shadow-2xl border border-slate-100 dark:border-slate-700 p-6 sm:p-8 relative overflow-hidden"
  >
    <!-- Decoración de cabecera -->
    <div
      class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary via-emerald-400 to-accent"
    >
    </div>

    <!-- Encabezado -->
    <div class="text-center mb-6">
      <div
        class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-primary/10 text-primary mb-3 shadow-inner"
      >
        <span class="material-symbols-outlined text-3xl">school</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">
        Portal Estudiantil SIGE+
      </h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
        Ingresa tu matrícula y contraseña oficial del SIGE
      </p>
    </div>

    <!-- Alert Container -->
    <div id="alert-container" class="hidden mb-6">
      <div id="alert" class="rounded-xl p-4 flex items-start gap-3">
        <span
          class="material-symbols-outlined text-2xl flex-shrink-0"
          id="alert-icon"></span>
        <div class="flex-1 min-w-0">
          <h4 class="text-sm font-semibold" id="alert-title"></h4>
          <p class="text-xs mt-0.5 leading-relaxed" id="alert-message"></p>
        </div>
        <button
          id="btn-close-alert"
          type="button"
          class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
        >
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <!-- Estado de Sincronización / Carga -->
    <div
      id="sync-status"
      class="hidden mb-6 p-4 rounded-xl bg-primary/5 dark:bg-primary/10 border border-primary/20 text-center animate-pulse"
    >
      <div class="flex flex-col items-center justify-center gap-2">
        <div
          class="w-8 h-8 border-3 border-primary border-t-transparent rounded-full animate-spin"
        >
        </div>
        <p
          id="sync-message"
          class="text-sm font-medium text-primary dark:text-emerald-400"
        >
          Conectando con el portal SIGE...
        </p>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Sincronizando materias, calificaciones y perfil
        </p>
      </div>
    </div>

    <!-- Formulario Automático Principal -->
    <form id="direct-login-form" class="space-y-4">
      <!-- Campo Matrícula -->
      <div>
        <label
          for="input-matricula"
          class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5"
        >
          Matrícula
        </label>
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"
          >
            <span class="material-symbols-outlined text-xl">badge</span>
          </div>
          <input
            type="text"
            id="input-matricula"
            name="matricula"
            required
            inputmode="numeric"
            autocomplete="username"
            placeholder="Ej. 2021004562"
            class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-medium text-sm"
          />
        </div>
      </div>

      <!-- Campo Contraseña -->
      <div>
        <label
          for="input-password"
          class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5"
        >
          Contraseña
        </label>
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"
          >
            <span class="material-symbols-outlined text-xl">lock</span>
          </div>
          <input
            type="password"
            id="input-password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="w-full pl-10 pr-11 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-medium text-sm"
          />
          <button
            type="button"
            id="btn-toggle-password"
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
            aria-label="Ver u ocultar contraseña"
          >
            <span
              class="material-symbols-outlined text-xl"
              id="icon-toggle-password">visibility</span
            >
          </button>
        </div>
      </div>

      <!-- Botón de Entrar -->
      <button
        type="submit"
        id="btn-submit-login"
        class="w-full mt-2 py-3.5 px-4 bg-primary hover:bg-primary/90 active:scale-[0.99] text-white font-bold rounded-xl shadow-lg shadow-primary/25 transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span class="material-symbols-outlined text-xl">login</span>
        <span>Iniciar Sesión en SIGE+</span>
      </button>
    </form>

    <!-- Indicador de Seguridad -->
    <div
      class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-700/80 flex items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400"
    >
      <span class="material-symbols-outlined text-emerald-500 text-base"
        >verified_user</span
      >
      <span>Conexión directa y cifrada con portal oficial UTSH</span>
    </div>

    <!-- Método Alternativo (Fallback Manual con Cookie) -->
    <div class="mt-4 pt-2">
      <details
        class="group text-xs text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 rounded-xl p-3"
      >
        <summary
          class="cursor-pointer font-medium flex items-center justify-between text-slate-600 dark:text-slate-300 select-none"
        >
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base">tune</span>
            ¿Problemas para entrar? Ingreso con Cookie
          </span>
          <span
            class="material-symbols-outlined transition-transform duration-200 group-open:rotate-180 text-base"
          >
            expand_more
          </span>
        </summary>
        <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700 space-y-2">
          <p class="text-[11px] leading-relaxed">
            Si cuentas con tu cookie <code class="bg-slate-100 dark:bg-slate-900 px-1 py-0.5 rounded font-mono">PHPSESSID</code> activa, pégala aquí:
          </p>
          <div class="flex gap-2">
            <input
              type="text"
              id="manual-cookie"
              placeholder="PHPSESSID=xxxxxx..."
              class="flex-1 px-3 py-2 text-xs border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white font-mono focus:ring-1 focus:ring-primary focus:outline-none"
            />
            <button
              type="button"
              id="btn-manual-sync"
              class="bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white px-3 py-2 rounded-lg font-medium text-xs whitespace-nowrap cursor-pointer transition-colors"
            >
              Usar Cookie
            </button>
          </div>
        </div>
      </details>
    </div>
  </div>

  <!-- Ayuda y Enlace Oficial -->
  <div class="text-center mt-6 text-xs text-slate-500 dark:text-slate-400">
    ¿Olvidaste tu contraseña o tienes dudas escolares?
    <a
      href="https://sige.utsh.edu.mx/estudiantes/"
      target="_blank"
      rel="noopener noreferrer"
      class="text-primary hover:underline font-semibold ml-1 inline-flex items-center gap-0.5"
    >
      Portal Oficial SIGE
      <span class="material-symbols-outlined text-xs">open_in_new</span>
    </a>
  </div>
</div>

<script>
  // Endpoints API
  const LOGIN_API = "/api/auth/sige-login";
  const EXTRACT_API = "/api/sige/extract-data";

  // URL de redirección
  const urlParams = new URLSearchParams(window.location.search);
  const redirectUrl = urlParams.get("redirect") || "/";

  // Elementos del DOM
  const form = document.getElementById("direct-login-form") as HTMLFormElement;
  const inputMatricula = document.getElementById("input-matricula") as HTMLInputElement;
  const inputPassword = document.getElementById("input-password") as HTMLInputElement;
  const btnSubmit = document.getElementById("btn-submit-login") as HTMLButtonElement;
  const btnTogglePassword = document.getElementById("btn-toggle-password");
  const iconTogglePassword = document.getElementById("icon-toggle-password");
  const syncStatus = document.getElementById("sync-status");
  const syncMessage = document.getElementById("sync-message");
  const alertContainer = document.getElementById("alert-container");
  const btnCloseAlert = document.getElementById("btn-close-alert");
  const manualCookieInput = document.getElementById("manual-cookie") as HTMLInputElement;
  const btnManualSync = document.getElementById("btn-manual-sync");

  // Rellenar matrícula previa si existe en localStorage
  const savedMatricula = localStorage.getItem("matricula");
  if (savedMatricula && inputMatricula) {
    inputMatricula.value = savedMatricula;
    inputPassword?.focus();
  }

  // Toggle para ver/ocultar contraseña
  btnTogglePassword?.addEventListener("click", () => {
    if (!inputPassword || !iconTogglePassword) return;
    const isPassword = inputPassword.type === "password";
    inputPassword.type = isPassword ? "text" : "password";
    iconTogglePassword.textContent = isPassword ? "visibility_off" : "visibility";
  });

  // Cerrar alerta
  btnCloseAlert?.addEventListener("click", () => {
    alertContainer?.classList.add("hidden");
  });

  function showAlert(type: "success" | "error" | "warning", title: string, message: string) {
    const alertEl = document.getElementById("alert");
    const iconEl = document.getElementById("alert-icon");
    const titleEl = document.getElementById("alert-title");
    const messageEl = document.getElementById("alert-message");

    if (!alertEl || !iconEl || !titleEl || !messageEl || !alertContainer) return;

    if (type === "success") {
      alertEl.className =
        "rounded-xl p-4 flex items-start gap-3 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200";
      iconEl.className = "material-symbols-outlined text-2xl flex-shrink-0 text-emerald-600 dark:text-emerald-400";
      iconEl.textContent = "check_circle";
    } else if (type === "error") {
      alertEl.className =
        "rounded-xl p-4 flex items-start gap-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200";
      iconEl.className = "material-symbols-outlined text-2xl flex-shrink-0 text-red-600 dark:text-red-400";
      iconEl.textContent = "error";
    } else {
      alertEl.className =
        "rounded-xl p-4 flex items-start gap-3 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-200";
      iconEl.className = "material-symbols-outlined text-2xl flex-shrink-0 text-amber-600 dark:text-amber-400";
      iconEl.textContent = "warning";
    }

    titleEl.textContent = title;
    messageEl.textContent = message;
    alertContainer.classList.remove("hidden");
  }

  function setSyncStatus(visible: boolean, message = "Conectando con el portal SIGE...") {
    if (!syncStatus) return;
    if (visible) {
      if (syncMessage) syncMessage.textContent = message;
      syncStatus.classList.remove("hidden");
    } else {
      syncStatus.classList.add("hidden");
    }
  }

  function saveStudentSession(result: any) {
    const user = result.user;
    if (!user) throw new Error("No se recibieron datos válidos del estudiante.");

    sessionStorage.setItem("user", JSON.stringify(user));
    sessionStorage.setItem("dataSource", "sige");
    if (result.data) {
      sessionStorage.setItem("academicData", JSON.stringify(result.data));
    }
    if (user.matricula) {
      localStorage.setItem("matricula", user.matricula);
    }

    return user;
  }

  // Submit del formulario automático (Matrícula + Contraseña)
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    alertContainer?.classList.add("hidden");

    const matricula = inputMatricula.value.trim();
    const password = inputPassword.value;

    if (!matricula || !password) {
      showAlert("warning", "Datos incompletos", "Por favor ingresa tu matrícula y contraseña.");
      return;
    }

    if (btnSubmit) {
      btnSubmit.disabled = true;
      btnSubmit.classList.add("opacity-60", "cursor-not-allowed");
    }
    setSyncStatus(true, "Autenticando en portal oficial SIGE...");

    try {
      const response = await fetch(LOGIN_API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ matricula, password }),
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Error al iniciar sesión con SIGE");
      }

      setSyncStatus(true, "¡Sesión validada! Sincronizando datos académicos...");

      const user = saveStudentSession(result);

      showAlert(
        "success",
        "¡Bienvenido/a!",
        `Hola ${user.nombre || "Estudiante"}, sesión iniciada correctamente. Redirigiendo...`,
      );

      setTimeout(() => {
        window.location.href = redirectUrl;
      }, 1000);
    } catch (err) {
      setSyncStatus(false);
      showAlert(
        "error",
        "Error de autenticación",
        err instanceof Error
          ? err.message
          : "Verifica que tu matrícula y contraseña sean las correctas del portal SIGE.",
      );
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.classList.remove("opacity-60", "cursor-not-allowed");
      }
    }
  });

  // Fallback con Cookie manual
  btnManualSync?.addEventListener("click", async () => {
    alertContainer?.classList.add("hidden");
    const cookieRaw = manualCookieInput.value.trim();
    const match = cookieRaw.match(/PHPSESSID=([^;]+)/);
    const phpsessid = match ? match[1] : cookieRaw;

    if (!phpsessid || phpsessid.length < 10) {
      showAlert("warning", "Cookie no válida", "Ingresa una cookie PHPSESSID válida.");
      return;
    }

    setSyncStatus(true, "Sincronizando datos con la cookie proporcionada...");

    try {
      const response = await fetch(EXTRACT_API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phpsessid }),
      });

      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || "No se pudo extraer la sesión del SIGE.");
      }

      const user = saveStudentSession(result);
      setSyncStatus(false);
      showAlert("success", "Sincronización exitosa", `Bienvenido/a ${user.nombre || ""}. Redirigiendo...`);

      setTimeout(() => {
        window.location.href = redirectUrl;
      }, 1000);
    } catch (err) {
      setSyncStatus(false);
      showAlert("error", "Error con la cookie", err instanceof Error ? err.message : "Error al procesar la cookie.");
    }
  });
</script>

<style>
  .material-symbols-outlined {
    font-variation-settings:
      "FILL" 0,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }
</style>
